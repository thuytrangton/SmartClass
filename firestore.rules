rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default Deny Catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Common helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 'thuytrangtonnu@gmail.com' && request.auth.token.email_verified == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Health-check / connection validation document
    match /test/{testId} {
      allow get, list: if true;
      allow write: if isValidId(testId);
    }

    // Admin collection
    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }

    // Users Collection
    match /users/{userId} {
      function isValidUser(data) {
        return data.id is string && data.id.size() <= 128 &&
               data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
               data.email is string && data.email.size() > 0 && data.email.size() <= 150 &&
               data.role in ['admin', 'teacher', 'student', 'parent'] &&
               (!('schoolName' in data) || (data.schoolName is string && data.schoolName.size() <= 200)) &&
               (!('avatar' in data) || (data.avatar is string && data.avatar.size() <= 500));
      }

      allow get, list: if true;
      allow create, update: if isValidId(userId) && isValidUser(incoming());
      allow delete: if isAdmin();
    }

    // Schools Collection
    match /schools/{schoolId} {
      allow get, list: if true;
      allow create, update: if isValidId(schoolId);
      allow delete: if isAdmin();
    }

    // Classes Collection
    match /classes/{classId} {
      function isValidClass(data) {
        return (!('id' in data) || (data.id is string && data.id.size() <= 128)) &&
               (!('name' in data) || (data.name is string && data.name.size() > 0 && data.name.size() <= 50));
      }

      allow get, list: if true;
      allow create, update: if isValidId(classId) && isValidClass(incoming());
      allow delete: if isValidId(classId);
    }

    // Students Collection
    match /students/{studentId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(studentId);
    }

    // Attendance Collection
    match /attendance/{attendanceId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(attendanceId);
    }

    // Grades Collection
    match /grades/{gradeId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(gradeId);
    }

    // Grade History Collection
    match /gradeHistory/{historyId} {
      allow get, list: if true;
      allow create, update: if isValidId(historyId);
      allow delete: if isAdmin();
    }

    // Assignments Collection
    match /assignments/{assignmentId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(assignmentId);
    }

    // Submissions Collection
    match /submissions/{submissionId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(submissionId);
    }

    // Quizzes Collection
    match /quizzes/{quizId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(quizId);
    }

    // Quiz Attempts Collection
    match /quizAttempts/{attemptId} {
      allow get, list: if true;
      allow create, update: if isValidId(attemptId);
      allow delete: if isAdmin();
    }

    // Behaviors Collection
    match /behaviors/{behaviorId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(behaviorId);
    }

    // Alerts Collection
    match /alerts/{alertId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(alertId);
    }

    // Announcements Collection
    match /announcements/{announcementId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(announcementId);
    }

    // Schedules Collection (Timetable)
    match /schedules/{scheduleId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(scheduleId);
    }

    // Learning Resources Collection
    match /resources/{resourceId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(resourceId);
    }

    // Chat Messages Collection
    match /messages/{messageId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(messageId);
    }

    // Audit Logs Collection
    match /auditLogs/{logId} {
      allow get, list: if true;
      allow create: if isValidId(logId);
      allow update, delete: if false;
    }

    // Questions Collection (Question Bank)
    match /questions/{questionId} {
      function isValidQuestion(data) {
        return data.id is string && data.id.size() <= 128 &&
               data.code is string && data.code.size() > 0 && data.code.size() <= 64 &&
               data.subject is string && data.subject.size() > 0 && data.subject.size() <= 100 &&
               data.gradeLevel is number && data.gradeLevel >= 1 && data.gradeLevel <= 12 &&
               data.type in ['single_choice', 'multiple_choice', 'true_false', 'fill_blank', 'essay'] &&
               data.difficulty in ['Nhận biết', 'Thông hiểu', 'Vận dụng', 'Vận dụng cao'] &&
               data.status in ['approved', 'pending', 'draft', 'rejected', 'archived'] &&
               data.content is string && data.content.size() > 0 && data.content.size() <= 10000;
      }

      allow get, list: if true;
      allow create, update: if isValidId(questionId) && isValidQuestion(incoming());
      allow delete: if isValidId(questionId);
    }

    // Topics Collection (Assignment Topics)
    match /topics/{topicId} {
      function isValidTopic(data) {
        return data.id is string && data.id.size() <= 128 &&
               data.name is string && data.name.size() > 0 && data.name.size() <= 300 &&
               (!('content' in data) || (data.content is string && data.content.size() <= 8000));
      }

      allow get, list: if true;
      allow create, update: if isValidId(topicId) && isValidTopic(incoming());
      allow delete: if isValidId(topicId);
    }
  }
}
